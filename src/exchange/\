#include "../../include/exchange.hpp"

Trader::Trader(Capital initialCapital, std::string userName) {
  totalCapital_ = initialCapital;
  name_ = userName;

  int clientSocket = socket(AF_INET, SOCK_STREAM, 0);

  if (clientSocket < 0) {
    std::cerr << "Failed to establish connection with server";
    return;
  }

  sockaddr_in address;
  address.sin_family = AF_INET;
  address.sin_port = htons(8080);
  address.sin_addr.s_addr = INADDR_ANY;

  connect(clientSocket, (const struct sockaddr *)&address, sizeof(address));

  std::string *initialmsg = userName + " is trying to establish connection";
  send(clientSocket, initialmsg, sizeof(initialmsg), 0);

  close(clientSocket);
}

int main() {
  Trader trader1(10000, "Bhavik");
  return 0;
}
